from typing import Generic, TypeVar

_T = TypeVar("_T")

class c_bint(int): ...
class c_int(int): ...
class c_float(float): ...
class c_double(float): ...

class Pointer(Generic[_T]):
    def __getitem__(self, index: int, /) -> _T: ...
    def __setitem__(self, index: int, value: _T, /) -> None: ...

class MemoryView(Generic[_T]):
    def __getitem__(self, index: int, /) -> _T: ...
    def __setitem__(self, index: int, value: _T, /) -> None: ...
